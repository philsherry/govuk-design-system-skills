## top-most EditorConfig file
root = true

## Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

## Prose and structured text
[*.{md,yaml,yml}]
indent_style = space

## Tab-first config files
[*.{json}]
indent_style = tab
